{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wwx/custom-ticker",
	"version": "0.1.0",
	"title": "Custom Ticker",
	"category": "widgets",
	"icon": "customs-alt",
	"description": "An custom ticker block",
	"attributes": {
		"tickerSpeed": {
			"type": "string",
			"default": "45"
		},
		"pauseOnHover": { 
			"type": "boolean",
			"default": true 
		}, 
		"tickerSpacing": {
			"type": "string",
			"default": "40"
		}
	}, 
	"textdomain": "custom-ticker", 
	"supports": {
		"align": ["full", "wide"]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}